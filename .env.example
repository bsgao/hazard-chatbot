OPENAI_API_KEY=
OPENAI_API_BASE=https://proxy.fast.luna.nasa.gov/
CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1
EMBED_BATCH_SIZE=5          # much smaller -> faster, safer requests
EMBED_MAX_CONCURRENCY=1
EMBED_MAX_RETRIES=10
EMBED_REQUEST_TIMEOUT=60    # smaller timeout = fail fast + retry instead of hanging
RUN_DEMO_SEARCH=0